{
  "name": "EXOTIC",
  "version": "0.2.0-dev",
  "status": "prototype",
  "architecture": {
    "planes": ["control", "intelligence", "execution", "evidence", "experience"],
    "verification_gate": true,
    "event_model": "append-only-hash-chain",
    "event_hash": "sha256",
    "default_mode": "simulation"
  },
  "core_capabilities": [
    {"id":"core.observe","authority":"read","risk":"low","maturity":"Implemented"},
    {"id":"core.plan","authority":"none","risk":"low","maturity":"Implemented"},
    {"id":"core.execute.echo","authority":"sandbox","risk":"low","maturity":"Implemented"}
  ],
  "runtime_features": [
    {"id":"core.identity.grants","maturity":"Implemented"},
    {"id":"core.policy.gate","maturity":"Implemented"},
    {"id":"core.verification.before_commit","maturity":"Implemented"},
    {"id":"core.events.sha256_chain","maturity":"Implemented"},
    {"id":"core.events.restart_recovery","maturity":"Implemented"},
    {"id":"core.http.loopback_status","maturity":"Implemented"},
    {"id":"core.http.public_status_projection","maturity":"Implemented"},
    {"id":"core.cognition.free_agent","maturity":"Implemented"}
  ],
  "gates": ["policy", "budget", "execution", "verification"],
  "network": {
    "status_bind": "127.0.0.1",
    "remote_exposure": "disabled"
  },
  "endpoints": [
    {"path":"/health","visibility":"internal","maturity":"Implemented"},
    {"path":"/version","visibility":"internal","maturity":"Implemented"},
    {"path":"/capabilities","visibility":"internal","maturity":"Implemented"},
    {"path":"/events","visibility":"internal","maturity":"Implemented"},
    {"path":"/public/status","visibility":"public","maturity":"Implemented"}
  ]
}
